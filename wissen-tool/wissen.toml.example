# Konfiguration fuer das Werkzeug `wissen`.
# Kopieren nach ~/.config/wissen/wissen.toml (oder ./wissen.toml) und anpassen.

[ablage]
# Das separate Git-Repository, in dem das Wissen landet.
pfad = "~/Wissensbasis"

[browser]
# Hier behaelt Chromium die Anmeldungen der Kursportale.
# Nicht ins Git-Repo legen -- darin stehen aktive Sitzungs-Cookies.
profil = "~/.local/share/wissen/browser-profil"

[youtube]
# Untertitelsprachen in Wunschreihenfolge. Von Hand erstellte Untertitel
# gewinnen immer gegen automatische, unabhaengig von dieser Liste.
sprachen = ["de", "de-DE", "en", "en-US"]
# Abstand der Zeitmarken im Transkript, in Sekunden.
marke_alle = 30

[web]
# Wartezeit nach dem Laden, damit nachgeladene Inhalte da sind (Millisekunden).
warte_ms = 1500

# Pro Kursportal lassen sich Selektoren hinterlegen. Ohne Eintrag arbeitet das
# Werkzeug mit Heuristiken -- das klappt oft, aber nicht immer. Wenn ein
# Transkript nicht gefunden wird: im Browser das Panel mit Rechtsklick ->
# "Untersuchen" ansehen und Klasse oder ID hier eintragen.
#
# [hosts."lernplattform.de"]
# klicks = ["button[data-purpose='transcript-toggle']"]
# transkript = ["[data-purpose='transcript-panel']"]
# inhalt = ["div.lesson-body"]
